{
  "manifest_version": 3,
  "name": "Reachard",
  "description": "Find company contacts from job pages, company sites, and LinkedIn profiles.",
  "version": "0.6.5",
  "minimum_chrome_version": "141",
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://reachard.co/*",
    "https://www.reachard.co/*",
    "https://contacts.reachard.co/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "http://localhost:8787/*",
    "http://127.0.0.1:8787/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_title": "Open Reachard"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://reachard.co/*",
        "https://www.reachard.co/*",
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "js": [
        "web_bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://reachard.co/*",
      "https://www.reachard.co/*",
      "https://contacts.reachard.co/*",
      "http://localhost:3000/*",
      "http://127.0.0.1:3000/*"
    ]
  },
  "icons": {
    "16": "icons/reachard.png",
    "48": "icons/reachard.png",
    "128": "icons/reachard.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
