PORT=8787
WEB_BASE_URL=http://localhost:3000
ALLOWED_WEB_ORIGINS=http://localhost:3000
CONTACT_PROVIDER=treg
TREG_TOKEN=
TREG_BASE_URL=https://treg.to
TREG_SEARCH_ENDPOINT=icypeas.people.search
TREG_SEARCH_SIZE=25
# Replenish if fewer than 10 valid colleagues or 3 role-related contacts (1-3 pages).
TREG_SEARCH_MAX_PAGES=3
TREG_SEARCH_TIMEOUT_MS=15000
TREG_EMAIL_ENDPOINT=apollo.people.enrich
TREG_REVEAL_TIMEOUT_MS=15000
HUNTER_API_KEY=
APOLLO_API_KEY=
APOLLO_MOCK=false
RAPIDAPI_KEY=
RAPIDAPI_PEOPLE_HOST=fresh-linkedin-scraper-api.p.rapidapi.com
RAPIDAPI_MAX_ATTEMPTS=2
RAPIDAPI_RETRY_BASE_MS=3000
EXPLORIUM_API_KEY=
EXPLORIUM_SEARCH_MODE=preview
EXPLORIUM_SEARCH_LIMIT=5
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-5.6-luna
OPENAI_INPUT_USD_PER_MILLION=0.20
OPENAI_CACHED_INPUT_USD_PER_MILLION=0.02
OPENAI_OUTPUT_USD_PER_MILLION=1.20
AI_DRAFT_TIMEOUT_MS=20000
AI_DRAFT_MAX_RESUME_CHARS=20000
AI_DRAFT_MAX_JD_CHARS=12000
AI_SEARCH_PLAN_TIMEOUT_MS=12000
AI_SEARCH_PLAN_MAX_JD_CHARS=4000
EXTENSION_ORIGIN=chrome-extension://your-extension-id
ALLOWED_EXTENSION_ORIGINS=chrome-extension://your-extension-id
