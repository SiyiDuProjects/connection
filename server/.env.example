HUNTER_TIMEOUT_MS=15000
HUNTER_MAX_DURATION=10
HUNTER_MIN_SCORE=70
APOLLO_TIMEOUT_MS=15000
GMAIL_SUBJECT_PREFIX=Quick question from a Berkeley student
