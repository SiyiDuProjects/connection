CONTACT_SEARCH_CREDITS=0
CONTACT_REVEAL_CREDITS=1
EMAIL_DRAFT_CREDITS=0
# Before disabling beta on an existing deployment, backfill membership period metadata.
BETA_UNLIMITED_USAGE=false
