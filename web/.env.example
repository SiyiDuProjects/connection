# Copy this template only when no local .env exists; keep existing private configuration.
# Note: this must be .env, not .env.local, without further configuration changes.
POSTGRES_URL=postgresql://***
STRIPE_SECRET_KEY=sk_test_***
STRIPE_WEBHOOK_SECRET=whsec_***
BASE_URL=http://localhost:3000
APP_URL=http://localhost:3000
NEXT_PUBLIC_WEB_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_CHROME_STORE_URL=
# Preserve any existing development allowlist when applying the store ID.
# The app merges these fields. Set NEXT_PUBLIC_CHROME_STORE_URL to the
# published Chrome Web Store listing used by the production website.
ALLOWED_EXTENSION_IDS=
CHROME_EXTENSION_ID=ladoemfclhhepfomibkdblodgnhceefm
# Only explicitly configured IDs can receive account tokens. Local unpacked
# testing can add its ID to ALLOWED_EXTENSION_IDS or explicitly opt into beta.
ALLOW_ANY_EXTENSION_ID=false
# Only explicitly enabled private beta environments bypass membership billing.
BETA_UNLIMITED_USAGE=false
AUTH_SECRET=***
# Use a sender on a domain verified in Resend. Never prefix the API key with NEXT_PUBLIC_.
EMAIL_FROM="Reachard <noreply@reachard.co>"
RESEND_API_KEY=
# Current Base grants 50 emails per billing period; Plus is personal unlimited.
# Grandfathered $8/$12 memberships retain their original 20/60-credit terms.
STRIPE_BASE_PRICE_ID=
STRIPE_PLUS_PRICE_ID=
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_EXPECTED_ACCOUNT_ID=
ADMIN_EMAILS=

# One Next.js runtime. Production Compose overrides PORT and proxy trust.
REACHARD_CONTACTS_ENABLED=1
REACHARD_TRUST_CLOUDFLARE_PROXY=0
HOSTNAME=127.0.0.1
PORT=3000
WEB_BASE_URL=http://localhost:3000
ALLOWED_WEB_ORIGINS=http://localhost:3000
CONTACT_PROVIDER=treg
TREG_TOKEN=
TREG_BASE_URL=https://treg.to
TREG_SEARCH_ENDPOINT=icypeas.people.search
TREG_SEARCH_SIZE=25
TREG_SEARCH_MAX_PAGES=3
TREG_SEARCH_TIMEOUT_MS=15000
TREG_EMAIL_ENDPOINT=apollo.people.enrich
TREG_REVEAL_TIMEOUT_MS=15000
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-6-luna
OPENAI_INPUT_USD_PER_MILLION=0.10
OPENAI_CACHED_INPUT_USD_PER_MILLION=0.01
OPENAI_OUTPUT_USD_PER_MILLION=0.50
AI_DRAFT_TIMEOUT_MS=20000
AI_DRAFT_MAX_RESUME_CHARS=20000
AI_DRAFT_MAX_JD_CHARS=12000
AI_SEARCH_PLAN_TIMEOUT_MS=12000
AI_SEARCH_PLAN_MAX_JD_CHARS=4000
EXTENSION_ORIGIN=chrome-extension://ladoemfclhhepfomibkdblodgnhceefm
ALLOWED_EXTENSION_ORIGINS=chrome-extension://ladoemfclhhepfomibkdblodgnhceefm
GMAIL_SUBJECT_PREFIX=Quick question from a Berkeley student
CONTACT_SEARCH_CREDITS=0
CONTACT_REVEAL_CREDITS=1
EMAIL_DRAFT_CREDITS=0
PROVIDER_DAILY_BUDGET_USD=10
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
RATE_LIMIT_UNAUTHENTICATED_MAX=60
PROVIDER_USER_CONCURRENCY=2
PROVIDER_GLOBAL_CONCURRENCY=8
PROVIDER_FAILURE_THRESHOLD=5
PROVIDER_CIRCUIT_COOLDOWN_MS=30000
